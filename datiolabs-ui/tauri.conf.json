{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DatioLabs",
  "version": "1.0.0",
  "identifier": "com.datiolabs.retail",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DatioLabs",
        "url": "demo/index.html",
        "additionalBrowserArgs": "--disable-gpu",
        "width": 1280,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/welcome.bmp",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}